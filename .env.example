# Copy this file to .env and adjust values. Never commit .env.
#
# The adapter only binds to loopback addresses. It refuses to start on 0.0.0.0.
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8765

# Ollama native API. The adapter calls POST /api/chat.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Filesystem root that model-generated file paths must stay inside.
# Start a separate adapter process (or restart it) for each project workspace.
ADAPTER_WORKSPACE=D:\projects\MyProjects\js\export_code

# Comma-separated allow-list of Ollama model names. Keep this narrow for 8 GB
# VRAM. If you use *, also include at least one concrete model so /v1/models
# can advertise a selectable model.
ADAPTER_MODELS=qwen2.5-coder:7b

# Optional bearer token. When set, /v1/* requires
# Authorization: Bearer <token>. /health stays public.
# Use a long random value, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADAPTER_API_KEY=

# Context and generation limits.
ADAPTER_NUM_CTX=16384
ADAPTER_MAX_OUTPUT_TOKENS=4096
ADAPTER_REQUEST_TIMEOUT=300

# Tool-call safety limits.
ADAPTER_MAX_TOOL_CALLS=4
ADAPTER_MAX_TOOL_CYCLES=12
ADAPTER_REPEAT_CALL_LIMIT=2

# Request/response size limits (bytes).
ADAPTER_MAX_REQUEST_BYTES=2000000
ADAPTER_MAX_RESPONSE_BYTES=8000000

# Tool results (file reads, command output) larger than this many characters
# are truncated before being sent back to Ollama, to protect the context window.
ADAPTER_MAX_TOOL_RESULT_CHARS=20000

# Shell-call guard rails. The adapter does not execute shell commands; it
# rejects obvious destructive commands and clamps timeouts before OpenCode
# executes the call.
ADAPTER_MAX_COMMAND_TIMEOUT_MS=120000
ADAPTER_MAX_COMMAND_LENGTH=8000

# Logging: DEBUG, INFO, WARNING, ERROR. Request bodies and file contents are
# never logged.
ADAPTER_LOG_LEVEL=INFO

# Optional Ollama keep_alive value, e.g. 5m. Empty uses the Ollama default.
ADAPTER_KEEP_ALIVE=

# Optional generation temperature override, e.g. 0.2. Empty uses Ollama's default.
ADAPTER_TEMPERATURE=
